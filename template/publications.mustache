{{> @preamble}}
<header class="pb-3 mb-4 border-bottom">
<h1 class="mb-1">Publications</h1>
<p class="text-body-secondary mb-0">{{profile.name}}</p>
</header>

{{#publications.groups.length}}
<nav class="d-flex flex-wrap gap-2 mb-4" aria-label="Publication categories">
{{#publications.groups}}
<a class="btn btn-outline-primary btn-sm" href="#{{id}}">{{category}}</a>
{{/publications.groups}}
</nav>

{{#publications.groups}}
<section id="{{id}}" class="mb-5">
<h2 class="border-bottom pb-2 mt-4">{{category}}</h2>
<ol class="mb-0">
{{#items}}
<li class="mb-2">
<div class="fw-semibold">{{title}}</div>
{{#authorsText}}<div>{{authorsText}}</div>{{/authorsText}}
{{#metaText}}<div class="text-body-secondary small">{{metaText}}</div>{{/metaText}}
{{#hasLinks}}
<div class="d-flex flex-wrap gap-2 mt-1">
{{#url}}<a class="btn btn-outline-secondary btn-sm" href="{{{url}}}">URL</a>{{/url}}
{{#archive}}<span class="btn btn-outline-primary btn-sm">{{archive}}</span>{{/archive}}
{{#field}}<span class="btn btn-outline-primary btn-sm">{{field}}</span>{{/field}}
</div>
{{/hasLinks}}
</li>
{{/items}}
</ol>
</section>
{{/publications.groups}}
{{/publications.groups.length}}

{{^publications.groups.length}}
<p>No publications listed.</p>
{{/publications.groups.length}}
{{> @postamble}}
