---
layout: wiki.liquid
pagination:
  data: collections.posts
  size: 1
  alias: post
permalink: "/{{ post.url }}"
eleventyComputed:
  title: "{{ post.title }}"
  subtitle: "{{ post.date }}"
catlinks:
  - Blog
---
<div class="void-article">{{ post.content }}</div>
<p>
  <a href="/blog.html">← Blog</a>
</p>
