{% comment %}
  main-menu.liquid — the Vector main menu, rendered twice in wiki.liquid:
  inside the header dropdown (vector-main-menu-unpinned-container) and in
  the pinned sidebar (vector-main-menu-pinned-container). wiki.liquid
  passes the isolated render scope explicitly: navigation, repoUrl, page,
  profileLinks. Sections: Navigation (active state via navActive filter on
  the link class) and Tools (Edit / View history / Discussion plus the
  external profile links).
{% endcomment %}
<div class="vector-main-menu">
  <div class="vector-menu">
    <div class="vector-menu-heading">Navigation</div>
    <ul class="vector-menu-content-list">
      {% for item in navigation %}
      <li class="mw-list-item">
        <a class="{{ item.href | navActive: page.url }}" href="{{ item.href }}">
          {{ item.label }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="vector-menu">
    <div class="vector-menu-heading">Tools</div>
    <ul class="vector-menu-content-list">
      <li class="mw-list-item"><a href="{{ page.url | editHref }}">Edit</a></li>
      <li class="mw-list-item"><a href="{{ repoUrl }}/commits/main">View history</a></li>
      <li class="mw-list-item"><a href="{{ repoUrl }}/issues">Discussion</a></li>
      {% for link in profileLinks %}
      <li class="mw-list-item"><a href="{{ link.url }}">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
  </div>
</div>
