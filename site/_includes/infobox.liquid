<aside class="infobox">
  {% if image %}
  <img class="infobox-image" src="{{ image }}" alt="{{ caption | default: '' }}" />
  {% endif %}
  {% if caption %}
  <div class="infobox-title">{{ caption }}</div>
  {% endif %}
  <table class="infobox-table">
    <tbody>
      {% for row in rows %}
      <tr>
        <th scope="row">{{ row.label }}</th>
        <td>{{ row.value }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</aside>
