<div class="toc" role="navigation">
  <div class="toctitle">
    <h2>Contents</h2>
  </div>
  <ul>
    {% for item in entries %}
    <li class="toclevel-{{ item.depth | plus: 1 }}">
      <a href="#{{ item.id }}">
        <span class="tocnumber">{{ item.number }}</span>
        <span class="toctext">{{ item.text }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
</div>
