---
layout: wiki.liquid
permalink: /blog.html
title: Blog
eleventyComputed:
  subtitle: "{{ site.profile.name }}"
catlinks:
  - Blog
---
{% if collections.posts.size > 0 %}
{% capture postsContent %}
<ol>
  {% for post in collections.posts %}
  <li>
    <h3>
      <a href="/{{ post.url }}">{{ post.title }}</a>
    </h3>
    {% if post.date %}
    <p>
      <small>{{ post.date }}</small>
    </p>
    {% endif %}
    {% if post.description %}
    <p>{{ post.description }}</p>
    {% endif %}
  </li>
  {% endfor %}
</ol>
{% endcapture %}
{% render 'section.liquid', id: 'posts', title: 'Posts', content: postsContent %}
{% else %}
<p>No posts yet.</p>
{% endif %}
