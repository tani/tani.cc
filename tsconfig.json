{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["vite/client"]
  },
  "include": ["pages", "src", "test", "vite.config.ts", "void.config.ts"]
}
